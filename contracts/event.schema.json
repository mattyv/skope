{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mattyv/skope/contracts/event.schema.json",
  "title": "Event",
  "description": "One line of skope's JSON Lines output on stdout (SPEC §10). Exactly one event shape matches, chosen by `event`. Every shape has the common fields ts, run_id, skill, skill_hash, host, and optionally section and line; run_id, skill and skill_hash are null before a run exists. Nothing else is allowed.",
  "oneOf": [
    {
      "$ref": "#/$defs/run_start"
    },
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/check_cmd"
    },
    {
      "$ref": "#/$defs/check"
    },
    {
      "$ref": "#/$defs/ask"
    },
    {
      "$ref": "#/$defs/sweep_item"
    },
    {
      "$ref": "#/$defs/sweep"
    },
    {
      "$ref": "#/$defs/effect_start"
    },
    {
      "$ref": "#/$defs/effect_end"
    },
    {
      "$ref": "#/$defs/change"
    },
    {
      "$ref": "#/$defs/would_do"
    },
    {
      "$ref": "#/$defs/page"
    },
    {
      "$ref": "#/$defs/would_page"
    },
    {
      "$ref": "#/$defs/handoff_page"
    },
    {
      "$ref": "#/$defs/transfer"
    },
    {
      "$ref": "#/$defs/outcome"
    },
    {
      "$ref": "#/$defs/handoff_record"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/warning"
    },
    {
      "$ref": "#/$defs/locked"
    },
    {
      "$ref": "#/$defs/stale_lock"
    }
  ],
  "$defs": {
    "run_start": {
      "title": "RunStartEvent",
      "type": "object",
      "description": "The run began.",
      "properties": {
        "ts": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "description": "UTC, ISO 8601."
        },
        "run_id": {
          "type": ["string", "null"],
          "description": "null before a run exists."
        },
        "skill": {
          "type": ["string", "null"],
          "description": "null before a run exists."
        },
        "skill_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "null before a run exists."
        },
        "host": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "description": "The section's display name."
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "const": "run_start"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dry_run": {
          "type": "boolean"
        },
        "caller": {
          "enum": ["person", "agent"]
        },
        "run_dir": {
          "type": "string"
        },
        "skope_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "skope_build": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Build identity, bare hex (SPEC §7.2)."
        },
        "effects_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "The skill's scope, as --effects and approvals hash it (SPEC §7.4), so a run can be matched to what was approved."
        },
        "from": {
          "type": "string",
          "description": "With --from: the section the run started at instead of the entry."
        }
      },
      "required": [
        "ts",
        "run_id",
        "skill",
        "skill_hash",
        "host",
        "event",
        "params",
        "dry_run",
        "caller",
        "run_dir",
        "effects_hash",
        "skope_version",
        "skope_build"
      ],
      "additionalProperties": false
    },
    "run": {
      "title": "RunEvent",
      "type": "object",
      "description": "A run command finished.",
      "properties": {
        "ts": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "description": "UTC, ISO 8601."
        },
        "run_id": {
          "type": ["string", "null"],
          "description": "null before a run exists."
        },
        "skill": {
          "type": ["string", "null"],
          "description": "null before a run exists."
        },
        "skill_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "null before a run exists."
        },
        "host": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "description": "The section's display name."
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "const": "run"
        },
        "cmd": {
          "type": "string"
        },
        "exit": {
          "type": ["integer", "null"],
          "description": "null when the command timed out or was killed."
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        },
        "timed_out": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "stdout_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "stdout_tail": {
          "type": "string",
          "maxLength": 2048,
          "description": "Redacted, at most 2KB."
        },
        "after_would_do": {
          "type": "boolean"
        }
      },
      "required": [
        "ts",
        "run_id",
        "skill",
        "skill_hash",
        "host",
        "event",
        "cmd",
        "exit",
        "ms",
        "timed_out",
        "truncated",
        "stdout_hash",
        "stdout_tail",
        "after_would_do"
      ],
      "additionalProperties": false
    },
    "check_cmd": {
      "title": "CheckCmdEvent",
      "type": "object",
      "description": "A command check finished.",
      "properties": {
        "ts": {
