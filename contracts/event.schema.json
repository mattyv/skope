          "description": "UTC, ISO 8601."
        },
        "run_id": {
          "type": ["string", "null"],
          "description": "null before a run exists."
        },
        "skill": {
          "type": ["string", "null"],
          "description": "null before a run exists."
        },
        "skill_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "null before a run exists."
        },
        "host": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "description": "The section's display name."
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "const": "check_cmd"
        },
        "cmd": {
          "type": "string"
        },
        "exit": {
          "type": ["integer", "null"],
          "description": "null when the command timed out or was killed."
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        },
        "timed_out": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "stdout_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "stdout_tail": {
          "type": "string",
          "maxLength": 2048,
          "description": "Redacted, at most 2KB."
        },
        "after_would_do": {
          "type": "boolean"
        }
      },
      "required": [
        "ts",
        "run_id",
        "skill",
        "skill_hash",
        "host",
        "event",
        "cmd",
        "exit",
        "ms",
        "timed_out",
        "truncated",
        "stdout_hash",
        "stdout_tail",
        "after_would_do"
      ],
      "additionalProperties": false
    },
    "check": {
      "title": "CheckEvent",
      "type": "object",
      "description": "A comparison was evaluated.",
      "properties": {
        "ts": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "description": "UTC, ISO 8601."
        },
        "run_id": {
          "type": ["string", "null"],
          "description": "null before a run exists."
        },
        "skill": {
          "type": ["string", "null"],
          "description": "null before a run exists."
        },
        "skill_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "null before a run exists."
        },
        "host": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "description": "The section's display name."
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "const": "check"
        },
        "expr": {
          "type": "string"
        },
        "left": {
          "type": ["string", "null"]
        },
        "right": {
          "type": ["string", "null"]
        },
        "result": {
          "type": ["boolean", "null"]
        },
        "after_would_do": {
          "type": "boolean"
        }
      },
      "required": ["ts", "run_id", "skill", "skill_hash", "host", "event", "expr", "left", "right", "result", "after_would_do"],
      "additionalProperties": false
    },
    "ask": {
      "title": "AskEvent",
      "type": "object",
      "description": "A question was asked. probs, chosen and confidence are null when the backend failed; detail then says why.",
      "properties": {
        "ts": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "description": "UTC, ISO 8601."
        },
        "run_id": {
          "type": ["string", "null"],
          "description": "null before a run exists."
        },
        "skill": {
          "type": ["string", "null"],
          "description": "null before a run exists."
        },
        "skill_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "null before a run exists."
        },
        "host": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "description": "The section's display name."
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "const": "ask"
        },
        "question": {
          "type": "string"
        },
        "kind": {
          "enum": ["choice", "yesno"]
        },
        "probs": {
          "type": ["object", "null"],
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "chosen": {
          "type": ["string", "integer", "null"]
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "sure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "passed": {
          "type": "boolean"
        },
        "backend": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        },
        "request_path": {
          "type": "string"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "after_would_do": {
          "type": "boolean"
        },
        "detail": {
          "enum": ["unavailable", "request_too_large"],
          "description": "Failed asks only."
        }
      },
      "required": [
        "ts",
        "run_id",
        "skill",
        "skill_hash",
        "host",
        "event",
        "question",
        "kind",
        "probs",
        "chosen",
        "confidence",
        "sure",
        "passed",
        "backend",
        "model",
        "ms",
        "request_path",
        "request_sha256",
        "after_would_do"
      ],
      "additionalProperties": false
    },
    "sweep_item": {
      "title": "SweepItemEvent",
      "type": "object",
      "description": "One line of an `ask each` command's output and what the backend said about it (SPEC §4.8). Emitted after the command's run event. Nothing acts on it.",
      "properties": {
        "ts": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "description": "UTC, ISO 8601."
        },
        "run_id": {
          "type": ["string", "null"],
          "description": "null before a run exists."
        },
        "skill": {
          "type": ["string", "null"],
          "description": "null before a run exists."
        },
        "skill_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "null before a run exists."
        },
        "host": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "description": "The section's display name."
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "const": "sweep_item"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "The item's position among the command's non-empty output lines."
        },
        "item": {
          "type": "string",
          "description": "The output line, redacted."
        },
        "question": {
          "type": "string"
        },
        "sure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "probs": {
          "type": ["object", "null"],
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "answer": {
          "enum": ["yes", "no", "unsure", null],
          "description": "yes or no when the gate passed, unsure when it didn't; null when the backend was unavailable."
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "backend": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        },
        "request_path": {
          "type": "string"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "detail": {
          "enum": ["unavailable"],
          "description": "The backend failed or its answer was invalid; the sweep stops."
        }
      },
      "required": [
        "ts",
        "run_id",
        "skill",
        "skill_hash",
        "host",
        "section",
        "line",
        "event",
        "index",
        "item",
        "question",
        "sure",
        "probs",
        "answer",
        "confidence",
        "backend",
        "model",
        "ms",
        "request_path",
        "request_sha256"
      ],
      "additionalProperties": false
    },
    "sweep": {
      "title": "SweepEvent",
      "type": "object",
      "description": "An `ask each` finished (SPEC §4.8): counts of each answer, and the report file listing every item.",
      "properties": {
        "ts": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "description": "UTC, ISO 8601."
        },
        "run_id": {
          "type": ["string", "null"],
          "description": "null before a run exists."
        },
        "skill": {
          "type": ["string", "null"],
          "description": "null before a run exists."
        },
        "skill_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "null before a run exists."
        },
        "host": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "description": "The section's display name."
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "const": "sweep"
        },
        "cmd": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "yes": {
          "type": "integer",
          "minimum": 0
        },
        "no": {
          "type": "integer",
          "minimum": 0
        },
        "unsure": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "Lines never asked about: past the 200-line cap, after the deadline, or after the backend failed."
        },
        "stopped": {
          "enum": ["deadline", "ask_unavailable", null],
          "description": "Why the sweep stopped early, if it did."
        },
        "path": {
          "type": ["string", "null"],
          "description": "The report file in the run directory."
        }
      },
      "required": [
        "ts",
        "run_id",
        "skill",
        "skill_hash",
        "host",
        "section",
        "line",
        "event",
        "cmd",
        "question",
        "yes",
        "no",
        "unsure",
        "skipped",
        "stopped",
        "path"
      ],
      "additionalProperties": false
    },
