{
  "skill": "error-triage",
  "format": 1,
  "entry": {
    "section": "s:triage",
    "src": 21
  },
  "params": {},
  "limits": {
    "run_timeout_ms": 30000,
    "do_timeout_ms": 300000,
    "deadline_ms": 900000,
    "ask_context_tokens": 4000
  },
  "sections": {
    "s:triage": {
      "name": "Triage",
      "src": 21,
      "guidance": "Read the recent errors and decide how to handle them.",
      "body": [
        {
          "src": 24,
          "run": {
            "cmd": [
              {
                "lit": "journalctl -p err --since -15min --no-pager"
              }
            ],
            "as": "errors"
          },
          "else": null
        },
        {
          "src": 25,
          "ask": {
            "question": [
              {
                "lit": "Given "
              },
              {
                "var": "errors"
              },
              {
                "lit": ", how should this burst be handled?"
              }
            ],
            "sure": 75,
            "else": {
              "section": "s:unsure"
            },
            "sections": [
              {
                "src": 26,
                "section": "s:noise"
              },
              {
                "src": 27,
                "section": "s:investigate"
              },
              {
                "src": 28,
                "section": "s:page"
              }
            ]
          }
        }
      ]
    },
    "s:noise": {
      "name": "Noise",
      "src": 30,
      "guidance": "Known noise: nothing is wrong and there's nothing to do.",
      "body": [
        {
          "src": 33,
          "stop": {}
        }
      ]
    },
    "s:investigate": {
      "name": "Investigate",
      "src": 35,
      "guidance": "Worth a human look, but not urgent: nothing is degraded yet.",
      "body": [
        {
          "src": 38,
          "hand_off": {}
        }
      ]
    },
    "s:page": {
      "name": "Page",
      "src": 43,
      "guidance": "Degraded service, an outage, or data at risk.",
      "body": [
        {
          "src": 46,
          "page": [
            {
              "var": "host"
            },
            {
              "lit": ": error burst needs attention. Run "
            },
            {
              "var": "run_id"
            },
            {
              "lit": " has the details."
            }
          ]
        }
      ]
    },
    "s:unsure": {
      "name": "Unsure",
      "src": 48,
      "guidance": "An unwatched alert shouldn't end in a handoff nobody reads. If the call is unclear, page.",
      "body": [
        {
          "src": 52,
          "page": [
            {
              "var": "host"
            },
            {
              "lit": ": error burst, handling unclear. Run "
            },
            {
              "var": "run_id"
            },
            {
              "lit": " has the details."
            }
          ]
        }
      ]
    }
  }
}
