{
  "skill": "disk-full",
  "format": 1,
  "entry": {
    "section": "s:triage",
    "src": 26
  },
  "params": {
    "mount": {
      "str": "/",
      "src": 14
    },
    "threshold": {
      "int": 85,
      "src": 15
    },
    "target": {
      "int": 80,
      "src": 16
    }
  },
  "limits": {
    "run_timeout_ms": 30000,
    "do_timeout_ms": 600000,
    "deadline_ms": 900000,
    "ask_context_tokens": 4000
  },
  "sections": {
    "s:triage": {
      "name": "Triage",
      "src": 26,
      "guidance": "Look at usage, recent errors and what's biggest on disk.",
      "body": [
        {
          "src": 29,
          "run": {
            "cmd": [
              {
                "lit": "df --output=pcent "
              },
              {
                "var": "mount"
              },
              {
                "lit": " | tail -1"
              }
            ],
            "as": "used"
          },
          "else": null
        },
        {
          "src": 30,
          "check": {
            "cond": {
              "cmp": {
                "op": "<",
                "l": {
                  "var": "used"
                },
                "r": {
                  "var": "threshold"
                }
              }
            },
            "then": {
              "stop": {}
            },
            "else": null
          }
        },
        {
          "src": 31,
          "run": {
            "cmd": [
              {
                "lit": "journalctl -p err -n 100 --no-pager"
              }
            ],
            "as": "errors"
          },
          "else": null
        },
        {
          "src": 32,
          "run": {
            "cmd": [
              {
                "lit": "du -xh -d2 /var /tmp /home | sort -h"
              }
            ],
            "as": "biggest"
          },
          "else": {
            "skip": {}
          }
        },
        {
          "src": 33,
          "ask": {
            "question": [
              {
                "lit": "Given "
              },
              {
                "var": "used"
              },
              {
                "lit": ", "
              },
              {
                "var": "errors"
              },
              {
                "lit": " and "
              },
              {
                "var": "biggest"
              },
              {
                "lit": ", what's the best next step?"
              }
            ],
            "sure": 85,
            "else": null,
            "sections": [
              {
                "src": 34,
                "section": "s:clean_up"
              },
              {
                "src": 35,
                "section": "s:restart"
              },
              {
                "src": 36,
                "section": "s:page"
              },
              {
                "src": 37,
                "section": "s:investigate"
              }
            ]
          }
        }
      ]
    },
    "s:clean_up": {
      "name": "Clean up",
      "src": 39,
      "guidance": "Run cleanups least risky first. Stop as soon as usage is under target.",
      "body": [
        {
          "src": 42,
          "for_each": {
            "var": "step",
            "list": {
              "section": "s:cleanups"
            },
            "body": [
              {
                "src": 43,
                "ask": {
                  "question": [
                    {
                      "lit": "Given "
                    },
                    {
                      "var": "used"
                    },
                    {
                      "lit": " and "
                    },
                    {
                      "var": "biggest"
                    },
                    {
                      "lit": ", is it worth running \""
                    },
                    {
                      "var": "step"
                    },
                    {
                      "lit": "\"?"
                    }
                  ],
                  "sure": 90,
                  "else": {
                    "skip": {}
                  },
                  "yesno": {
                    "as": "_yn"
                  }
                }
              },
              {
                "src": 44,
                "if_yes": {
                  "do": {
                    "item": "step"
                  },
                  "else": {
                    "skip": {}
                  }
                }
              },
              {
                "src": 45,
                "run": {
                  "cmd": [
                    {
                      "lit": "df --output=pcent "
                    },
                    {
                      "var": "mount"
                    },
                    {
                      "lit": " | tail -1"
                    }
                  ],
                  "as": "used"
                },
                "else": null
              },
              {
                "src": 46,
                "check": {
                  "cond": {
                    "cmp": {
                      "op": "<",
                      "l": {
                        "var": "used"
                      },
                      "r": {
                        "var": "target"
                      }
                    }
                  },
                  "then": {
                    "stop": {}
                  },
                  "else": null
                }
              }
            ]
          }
        },
        {
          "src": 47,
          "then": {
            "section": "s:page"
          }
        }
      ]
    },
    "s:restart": {
      "name": "Restart",
      "src": 49,
      "guidance": "Restart the one service most likely behind the growth. Never more than one.",
      "body": [
        {
          "src": 52,
          "ask": {
            "question": [
              {
                "lit": "Given "
              },
              {
                "var": "errors"
              },
              {
                "lit": " and "
              },
              {
                "var": "biggest"
              },
              {
                "lit": ", which service is behind it?"
              }
            ],
            "sure": 90,
            "else": null,
            "one_of": {
              "list": {
                "section": "s:services"
              },
              "as": "service"
            }
          }
        },
        {
          "src": 53,
          "do": {
            "cmd": [
              {
                "lit": "systemctl restart "
              },
              {
                "var": "service"
              }
            ]
          },
          "else": null
        },
        {
          "src": 54,
          "run": {
            "cmd": [
              {
                "lit": "df --output=pcent "
              },
              {
                "var": "mount"
              },
              {
                "lit": " | tail -1"
              }
            ],
            "as": "used"
          },
          "else": null
        },
        {
          "src": 55,
          "check": {
            "cond": {
              "cmp": {
                "op": "<",
                "l": {
                  "var": "used"
                },
                "r": {
                  "var": "target"
                }
              }
            },
            "then": {
              "stop": {}
            },
            "else": null
          }
        },
        {
          "src": 56,
          "then": {
            "section": "s:page"
          }
        }
      ]
    },
    "s:page": {
      "name": "Page",
      "src": 58,
      "guidance": "Nothing here is safe to try automatically. Tell a human.",
      "body": [
        {
          "src": 61,
          "page": [
            {
              "var": "host"
            },
            {
              "lit": ": "
            },
            {
              "var": "mount"
            },
            {
              "lit": " at "
            },
            {
              "var": "used"
            },
            {
              "lit": ". Run "
            },
            {
              "var": "run_id"
            },
            {
              "lit": " has the errors and biggest dirs."
            }
          ]
        }
      ]
    },
    "s:investigate": {
      "name": "Investigate",
      "src": 63,
      "guidance": "Nothing in the lists fits. Work out what's filling the disk from the errors and sizes gathered in Triage. Don't run anything outside Cleanups or Services without asking a human first.",
      "body": [
        {
          "src": 64,
          "hand_off": {}
        }
      ]
    },
    "s:cleanups": {
      "name": "Cleanups",
      "src": 73,
      "lists": [
        {
          "src": 76,
          "items": [
            {
              "src": 76,
              "action": {
                "label": "Vacuum the journal to 500MB",
                "cmd": [
                  {
                    "lit": "journalctl --vacuum-size=500M"
                  }
                ]
              }
            },
            {
              "src": 77,
              "action": {
                "label": "Clear the apt cache",
                "cmd": [
                  {
                    "lit": "apt-get clean"
                  }
                ]
              }
            },
            {
              "src": 78,
              "action": {
                "label": "Delete rotated logs older than 7 days",
                "cmd": [
                  {
                    "lit": "find /var/log -name '*.gz' -mtime +7 -delete"
                  }
                ]
              }
            },
            {
              "src": 79,
              "action": {
                "label": "Delete /tmp files older than 7 days",
                "cmd": [
                  {
                    "lit": "find /tmp -type f -mtime +7 -delete"
                  }
                ]
              }
            },
            {
              "src": 80,
              "action": {
                "label": "Prune unused docker images",
                "cmd": [
                  {
                    "lit": "docker image prune -af"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "s:services": {
      "name": "Services",
      "src": 82,
      "lists": [
        {
          "src": 83,
          "items": [
            {
              "src": 83,
              "value": "nginx"
            },
            {
              "src": 84,
              "value": "rsyslog"
            },
            {
              "src": 85,
              "value": "myapp-worker"
            },
            {
              "src": 86,
              "value": "myapp-api"
            }
          ]
        }
      ]
    }
  }
}
