{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["src/**", "tests/**", "scripts/**", "contracts/**", "!src/contracts.gen.ts"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 140
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noExplicitAny": "off",
        // The core program contract has a `then` field (a check's target).
        "noThenProperty": "off"
      }
    }
  }
}
