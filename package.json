{
  "name": "skop",
  "version": "0.1.0",
  "description": "Run dual-use skills: Markdown an agent can read and a small, proven runtime can execute.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "skop": "dist/cli.js"
  },
  "files": [
    "dist",
    "core/generated",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "core": "node scripts/build-core.mjs",
    "build": "node scripts/build-id.mjs --write dist/build-identity.json && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "bignumber.js": "^9.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
