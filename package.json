{
  "name": "skope",
  "version": "0.1.0-beta.1",
  "description": "Run dual-use skills: Markdown an agent can read and a small, proven runtime can execute.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattyv/skope.git"
  },
  "type": "module",
  "bin": {
    "skope": "dist/cli.js",
    "skope-ask": "dist/ask/cli.js"
  },
  "files": [
    "dist",
    "core/generated",
    "scripts/postinstall.mjs",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "core": "node scripts/build-core.mjs",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node scripts/build-id.mjs --write dist/build-identity.json && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "postinstall": "node scripts/postinstall.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "bignumber.js": "9.3.1",
    "js-yaml": "^4.3.2",
    "markdown-it": "^15.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.19.43",
    "ajv": "^8.20.0",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "^15.0.4",
    "postject": "1.0.0-alpha.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
